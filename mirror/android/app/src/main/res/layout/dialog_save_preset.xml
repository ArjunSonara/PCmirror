<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard_card"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvSaveTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💾 Save Custom Aspect Ratio"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPresetDetailsPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Scale: 100% | Offset: (0, 0)"
        android:textColor="#58A6FF"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preset Name"
        android:textColor="#C9D1D9"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etPresetName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:hint="e.g. GTA Ultrawide / Zoom 1.3x"
        android:textColorHint="#6E7681"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Cancel"
            android:textColor="#C9D1D9"
            android:textSize="12sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_glow"
            android:text="Save Preset"
            android:textColor="#090D14"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>
</LinearLayout>
