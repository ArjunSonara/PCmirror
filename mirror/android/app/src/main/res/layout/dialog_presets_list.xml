<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📂 Saved Aspect Ratio Presets"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a custom preset to instantly restore your screen view."
        android:textColor="#8B949E"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp">

        <LinearLayout
            android:id="@+id/presetsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyPresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No custom presets saved yet.\nAdjust your screen with 2 fingers and tap 'Save View' to save one!"
                android:textColor="#6E7681"
                android:textSize="12sp"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btnClosePresets"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Close"
            android:textColor="#C9D1D9"
            android:textSize="12sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>
</LinearLayout>
